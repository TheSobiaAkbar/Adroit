<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/company_admob_test_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ad" />

    <ImageView
        android:id="@+id/company_admob_test_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/company_admob_test_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/company_admob_test_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/company_admob_test_advertiser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <RatingBar
        android:id="@+id/company_admob_test_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="true" />

    <TextView
        android:id="@+id/company_admob_test_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/company_admob_test_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/company_admob_test_media"
        android:layout_width="match_parent"
        android:layout_height="200dp" />

    <Button
        android:id="@+id/company_admob_test_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
