<?xml version="1.0" encoding="utf-8"?>
<!--
    The card behind every native template. Change its parts (company_admob_native_background, _stroke,
    company_admob_native_card_corner_radius, _card_stroke_width), or replace the whole shape: a drawable named
    company_admob_native_card in your app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/company_admob_native_background" />
    <stroke
        android:width="@dimen/company_admob_native_card_stroke_width"
        android:color="@color/company_admob_native_stroke" />
    <corners android:radius="@dimen/company_admob_native_card_corner_radius" />
</shape>
