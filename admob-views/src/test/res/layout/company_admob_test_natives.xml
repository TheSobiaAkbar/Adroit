<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.company.admob.views.AdNativeView
        android:id="@+id/company_admob_test_native_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:company_admob_placement="feed"
        app:company_admob_template="small" />

    <com.company.admob.views.AdNativeView
        android:id="@+id/company_admob_test_native_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:company_admob_layout="@layout/company_admob_test_custom_native"
        app:company_admob_placement="feed" />
</LinearLayout>
