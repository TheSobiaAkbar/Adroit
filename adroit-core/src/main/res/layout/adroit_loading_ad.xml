<?xml version="1.0" encoding="utf-8"?>
<!--
    The "Loading ad…" screen shown before a full-screen ad (docs/AD_PROFILES.md#loading). Replace it by declaring a
    layout with this name in your app; the library only inflates it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/adroit_loading_ad_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/adroit_loading_ad"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead" />
    </LinearLayout>
</FrameLayout>
