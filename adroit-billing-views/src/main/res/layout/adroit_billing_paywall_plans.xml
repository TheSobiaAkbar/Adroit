<?xml version="1.0" encoding="utf-8"?>
<!-- The "plans" paywall template. Override it by name to change the layout; views are found by id, and any of them
     may be left out except adroit_billing_content, adroit_billing_cta and adroit_billing_disclosure. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adroit_billing_paywall_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/adroit_billing_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/adroit_billing_padding"
        android:paddingTop="@dimen/adroit_billing_spacing"
        android:paddingEnd="@dimen/adroit_billing_padding"
        android:paddingBottom="@dimen/adroit_billing_spacing">

        <!-- Shrinks first when the texts are long: the purchase button and terms stay visible. wrap_content, not 0dp:
             in the dialog and bottom-sheet templates the card wraps its content. -->
        <ScrollView
            android:id="@+id/adroit_billing_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:ignore="InefficientWeight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <ImageView
                    android:id="@+id/adroit_billing_header_image"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/adroit_billing_title"
                    style="@style/Adroit.Billing.Paywall.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/adroit_billing_spacing"
                    android:accessibilityHeading="true"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/adroit_billing_subtitle"
                    style="@style/Adroit.Billing.Paywall.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/adroit_billing_features"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/adroit_billing_spacing"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/adroit_billing_plans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/adroit_billing_message"
            style="@style/Adroit.Billing.Paywall.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#FFB3261E"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/adroit_billing_spacing">

            <Button
                android:id="@+id/adroit_billing_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/adroit_billing_cta_height"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/adroit_billing_body_text" />

            <ProgressBar
                android:id="@+id/adroit_billing_cta_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/adroit_billing_disclosure"
            style="@style/Adroit.Billing.Paywall.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/adroit_billing_footer"
            style="@style/Adroit.Billing.Paywall.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/adroit_billing_restore"
                style="@style/Adroit.Billing.Paywall.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adroit_billing_paywall_restore" />

            <Button
                android:id="@+id/adroit_billing_manage"
                style="@style/Adroit.Billing.Paywall.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adroit_billing_paywall_manage" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/adroit_billing_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="48dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/adroit_billing_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/adroit_billing_status_title"
            style="@style/Adroit.Billing.Paywall.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/adroit_billing_status_text"
            style="@style/Adroit.Billing.Paywall.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <Button
            android:id="@+id/adroit_billing_done"
            style="@style/Adroit.Billing.Paywall.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/adroit_billing_spacing"
            android:text="@string/adroit_billing_paywall_done" />
    </LinearLayout>

    <include layout="@layout/adroit_billing_close_button" />
</FrameLayout>
