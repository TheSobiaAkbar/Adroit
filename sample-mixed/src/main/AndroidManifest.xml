<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        hardwareAccelerated is the default since API 14; it's explicit because Google requires hardware acceleration
        for video ads, so it must never be turned off for a window that shows ads:
        https://developers.google.com/admob/android/next-gen/banner#hardware_acceleration_for_video_ads
    -->
    <application
        android:name=".SampleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdsPlugin">
        <!-- XML: the splash, excluded from the app open ad by class name (SampleAds). -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- XML: bottom navigation over Fragments; the Feed Fragment's screen is Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <!-- Compose, embedding an XML layout with a native ad view. -->
        <activity
            android:name=".DetailsActivity"
            android:exported="false" />
        <activity
            android:name=".styles.NativeStylesActivity"
            android:exported="false" />

        <!-- Required by the Google Mobile Ads and UMP SDKs. Injected from Gradle: Google's sample app ID by default. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>

</manifest>
