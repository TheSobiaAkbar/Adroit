<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared by AdBannerView and AdNativeView: the placement key from your configuration. -->
    <attr name="adroit_placement" format="string" />

    <declare-styleable name="AdroitAdBannerView">
        <attr name="adroit_placement" />
        <attr name="adroit_bannerSize" format="enum">
            <enum name="anchoredAdaptive" value="0" />
            <enum name="inlineAdaptive" value="1" />
            <enum name="mediumRectangle" value="2" />
            <enum name="standard" value="3" />
            <enum name="collapsibleBottom" value="4" />
            <enum name="collapsibleTop" value="5" />
        </attr>
        <!-- Maximum height of an inlineAdaptive banner. Defaults to @dimen/adroit_banner_inline_max_height. -->
        <attr name="adroit_inlineMaxHeight" format="dimension" />
        <!-- GONE while there's no ad (Hidden or Failed). Default true. -->
        <attr name="adroit_collapseWhenEmpty" format="boolean" />
    </declare-styleable>

    <declare-styleable name="AdroitAdNativeView">
        <attr name="adroit_placement" />
        <!-- A library template; without it (and without adroit_layout), the placement's style decides.
             The values are NativeStyle's ordinals: keep them in its order. -->
        <attr name="adroit_template" format="enum">
            <enum name="small_button_end" value="0" />
            <enum name="small_button_bottom" value="1" />
            <enum name="large_button_bottom" value="2" />
            <enum name="large_compact" value="3" />
            <enum name="media_start" value="4" />
        </attr>
        <!-- Your own layout. It must use the standard template ids (adroit_native_headline, ...). -->
        <attr name="adroit_layout" format="reference" />
    </declare-styleable>

    <!-- AdSlotView: a banner or native ad, whichever format the placement has now (docs/AD_PROFILES.md). -->
    <declare-styleable name="AdroitAdSlotView">
        <attr name="adroit_placement" />
    </declare-styleable>

    <!--
        Template styling. Every native template applies Adroit.ThemeOverlay.Native, which sets all of these.
        To restyle the templates, override that style (or the colors, dimens and styles it references) in your app.
    -->
    <attr name="adroit_nativeBackground" format="reference|color" />
    <attr name="adroit_nativeCtaBackground" format="reference|color" />
    <attr name="adroit_nativeCtaTextColor" format="reference|color" />
    <attr name="adroit_nativeAttributionBackground" format="reference|color" />
    <attr name="adroit_nativeTextAppearanceHeadline" format="reference" />
    <attr name="adroit_nativeTextAppearanceBody" format="reference" />
    <attr name="adroit_nativeTextAppearanceCaption" format="reference" />
    <attr name="adroit_nativeTextAppearanceAttribution" format="reference" />
</resources>
