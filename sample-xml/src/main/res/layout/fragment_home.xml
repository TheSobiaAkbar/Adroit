<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <Button
                android:id="@+id/level_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/level_complete" />

            <Button
                android:id="@+id/extra_life"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extra_life" />

            <Button
                android:id="@+id/bonus_round"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bonus_round" />

            <!-- The counter and timer strategies (docs/AD_PROFILES.md, "Counter and timer"): tap again and again,
                 and the line below says what each tap did. -->
            <Button
                android:id="@+id/counter_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/counter_ad" />

            <Button
                android:id="@+id/timer_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timer_ad" />

            <TextView
                android:id="@+id/strategy_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- Replaces the home banner with a new one; the shown one stays until the new one has loaded. -->
            <Button
                android:id="@+id/refresh_banner"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/refresh_banner" />
        </LinearLayout>
    </ScrollView>

    <!-- A banner, or a native ad if Firebase swaps HomeBanner's format: AdSlotView follows the swap. It follows this
         Fragment's view lifecycle and stays GONE without an ad. Size or template come from HomeBanner's style. -->
    <io.github.thesobiaakbar.adroit.views.AdSlotView
        android:id="@+id/home_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adroit_placement="HomeBanner" />
</LinearLayout>
