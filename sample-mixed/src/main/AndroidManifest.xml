<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        hardwareAccelerated is the default since API 14; it's explicit because Google requires hardware acceleration
        for video ads, so it must never be turned off for a window that shows ads:
        https://developers.google.com/admob/android/next-gen/banner#hardware_acceleration_for_video_ads
    -->
    <application
        android:name=".MixedApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LegacyXmlActivity"
            android:exported="false" />
        <activity
            android:name=".ComposeHostActivity"
            android:exported="false" />

        <!-- Required by the Google Mobile Ads and UMP SDKs. Injected from Gradle: Google's sample app ID by default. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>

</manifest>
