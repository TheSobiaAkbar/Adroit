<?xml version="1.0" encoding="utf-8"?>
<!-- A classic XML layout, embedded in DetailsActivity's Compose screen through AndroidView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/details_body" />

    <!-- Loads for the view tree's lifecycle owner (the hosting Activity); GONE if nothing loads. -->
    <com.company.admob.views.AdNativeView
        android:id="@+id/details_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:company_admob_placement="ArticleNative" />
</LinearLayout>
