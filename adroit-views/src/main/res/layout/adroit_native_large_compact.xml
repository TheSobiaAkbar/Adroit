<?xml version="1.0" encoding="utf-8"?>
<!-- large_compact: a larger icon, "Ad" badge, headline and body, then shorter media and a full-width call to action. -->
<!-- Overdraw: the template is embedded in your screen, not a window root. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/adroit_nativeBackground"
    android:orientation="vertical"
    android:padding="@dimen/adroit_native_spacing"
    android:theme="@style/Adroit.ThemeOverlay.Native"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/adroit_native_adchoices_space">

        <ImageView
            android:id="@+id/adroit_native_icon"
            style="@style/Adroit.Native.Icon"
            android:layout_width="@dimen/adroit_native_icon_size_large"
            android:layout_height="@dimen/adroit_native_icon_size_large"
            android:layout_marginEnd="@dimen/adroit_native_spacing" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/adroit_native_attribution"
                    style="@style/Adroit.Native.Attribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/adroit_native_spacing_small" />

                <TextView
                    android:id="@+id/adroit_native_headline"
                    style="@style/Adroit.Native.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/adroit_native_body"
                style="@style/Adroit.Native.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/adroit_native_spacing_tiny" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adroit_native_media"
        android:layout_width="match_parent"
        android:layout_height="@dimen/adroit_native_media_height_compact"
        android:layout_marginTop="@dimen/adroit_native_spacing"
        android:contentDescription="@string/adroit_native_media_description" />

    <android.widget.Button
        android:id="@+id/adroit_native_cta"
        style="@style/Adroit.Native.Cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/adroit_native_spacing" />

</LinearLayout>
