<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Visible only while UMP requires a privacy options entry point. -->
    <Button
        android:id="@+id/privacy_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_options"
        android:visibility="gone" />

    <!-- Premium: from AdroitBilling.entitlements only. -->
    <TextView
        android:id="@+id/premium_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <Button
        android:id="@+id/upgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/upgrade" />

    <Button
        android:id="@+id/restore"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/restore_purchases" />

    <Button
        android:id="@+id/manage"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_subscription" />

    <!-- Debug builds only. -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/demo_billing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_billing"
        android:visibility="gone" />

    <!-- Debug builds only: the active Firebase AppUpdate type. -->
    <TextView
        android:id="@+id/firebase_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <Button
        android:id="@+id/ad_inspector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ad_inspector" />

    <Button
        android:id="@+id/native_styles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/native_styles" />
</LinearLayout>
