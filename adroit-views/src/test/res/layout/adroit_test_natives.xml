<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.github.thesobiaakbar.adroit.views.AdNativeView
        android:id="@+id/adroit_test_native_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adroit_placement="feed"
        app:adroit_template="small_button_end" />

    <io.github.thesobiaakbar.adroit.views.AdNativeView
        android:id="@+id/adroit_test_native_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adroit_layout="@layout/adroit_test_custom_native"
        app:adroit_placement="feed" />
</LinearLayout>
