<?xml version="1.0" encoding="utf-8"?>
<!-- One plan of the plans template. Read as a radio button by accessibility services. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/adroit_billing_touch_target"
    android:orientation="horizontal"
    android:padding="16dp">

    <RadioButton
        android:id="@+id/adroit_billing_plan_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adroit_billing_plan_name"
            style="@style/Adroit.Billing.Paywall.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/adroit_billing_plan_price"
            style="@style/Adroit.Billing.Paywall.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adroit_billing_plan_trial"
            style="@style/Adroit.Billing.Paywall.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/colorAccent"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/adroit_billing_plan_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/adroit_billing_small_text"
        android:visibility="gone" />
</LinearLayout>
