<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- The CreditsStore paywall embedded in the screen, by name; its Firebase key changes it. -->
    <io.github.thesobiaakbar.adroit.billing.views.PaywallView
        android:id="@+id/credits_paywall"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:adroit_billing_paywall="CreditsStore"
        app:adroit_billing_placement="credits" />
</LinearLayout>
