<?xml version="1.0" encoding="utf-8"?>
<!--
    Every size of the native templates and their shimmer. Override any of them in your app with a dimen of the same
    name. Sizes use sdp and text sizes ssp (com.intuit.sdp, com.intuit.ssp), so they scale with the screen width; each
    matches the dp size a 360dp-wide phone had before. The few kept in dp are fixed by Google (AdChoices, the "Ad"
    badge's minimum, video's 120dp minimum) or are hairlines.
-->
<resources>
    <dimen name="company_admob_banner_inline_max_height">250dp</dimen>

    <dimen name="company_admob_native_spacing_tiny">@dimen/_2sdp</dimen>
    <dimen name="company_admob_native_spacing_small">@dimen/_3sdp</dimen>
    <dimen name="company_admob_native_spacing">@dimen/_7sdp</dimen>
    <dimen name="company_admob_native_spacing_large">@dimen/_13sdp</dimen>
    <dimen name="company_admob_native_icon_size">@dimen/_34sdp</dimen>
    <dimen name="company_admob_native_icon_size_large">@dimen/_40sdp</dimen>
    <!-- Google's AdChoices icon is added by the SDK in a top corner, at a fixed size: keep this much free there. -->
    <dimen name="company_admob_native_adchoices_space">24dp</dimen>
    <!-- Google requires an attribution badge at least 15px high and wide; 16dp is at least that at any density. -->
    <dimen name="company_admob_native_attribution_min_size">16dp</dimen>
    <dimen name="company_admob_native_cta_min_height">@dimen/_33sdp</dimen>
    <!-- About 16:9 at phone widths, and above Google's 120x120dp minimum for video. -->
    <dimen name="company_admob_native_media_min_height">@dimen/_150sdp</dimen>
    <dimen name="company_admob_native_media_min_height_large">@dimen/_183sdp</dimen>
    <!-- The media height of large_button_bottom. -->
    <dimen name="company_admob_native_media_height">@dimen/_133sdp</dimen>
    <!-- The media height of large_compact and media_start: Google's 120dp minimum for video, in dp so it
         never drops below it on small screens. -->
    <dimen name="company_admob_native_media_height_compact">120dp</dimen>
    <dimen name="company_admob_native_corner_radius">@dimen/_3sdp</dimen>

    <!-- The card behind each template (drawable company_admob_native_card). -->
    <dimen name="company_admob_native_card_corner_radius">@dimen/_7sdp</dimen>
    <dimen name="company_admob_native_card_stroke_width">1dp</dimen>
    <dimen name="company_admob_native_cta_corner_radius">@dimen/_5sdp</dimen>
    <dimen name="company_admob_native_attribution_corner_radius">@dimen/_2sdp</dimen>

    <!-- Text sizes. -->
    <dimen name="company_admob_native_headline_text_size">@dimen/_12ssp</dimen>
    <dimen name="company_admob_native_body_text_size">@dimen/_11ssp</dimen>
    <dimen name="company_admob_native_caption_text_size">@dimen/_10ssp</dimen>
    <dimen name="company_admob_native_cta_text_size">@dimen/_12ssp</dimen>
    <dimen name="company_admob_native_attribution_text_size">@dimen/_8ssp</dimen>

    <!-- The shimmer's blocks (AdShimmerView): their corners, and the padding of a banner's shimmer. -->
    <dimen name="company_admob_shimmer_corner_radius">@dimen/_3sdp</dimen>
    <dimen name="company_admob_shimmer_padding">@dimen/_7sdp</dimen>
</resources>
