<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <Button
                android:id="@+id/level_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/level_complete" />

            <Button
                android:id="@+id/extra_life"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extra_life" />

            <Button
                android:id="@+id/bonus_round"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bonus_round" />
        </LinearLayout>
    </ScrollView>

    <!-- A banner declared in XML. It follows this Fragment's view lifecycle and stays GONE without an ad. Its size
         comes from the ads file (home_banner's style). -->
    <com.company.admob.views.AdBannerView
        android:id="@+id/home_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:company_admob_placement="home_banner" />
</LinearLayout>
