<?xml version="1.0" encoding="utf-8"?>
<!-- small_button_bottom: icon, "Ad" badge, headline and body, with a full-width call to action below. No media. -->
<!-- Overdraw: the template is embedded in your screen, not a window root. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/adroit_nativeBackground"
    android:orientation="vertical"
    android:padding="@dimen/adroit_native_spacing"
    android:theme="@style/Adroit.ThemeOverlay.Native"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/adroit_native_adchoices_space">

        <include layout="@layout/adroit_native_part_header" />
    </LinearLayout>

    <android.widget.Button
        android:id="@+id/adroit_native_cta"
        style="@style/Adroit.Native.Cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/adroit_native_spacing" />

</LinearLayout>
