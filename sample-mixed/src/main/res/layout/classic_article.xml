<?xml version="1.0" encoding="utf-8"?>
<!-- A classic XML layout, embedded in ComposeHostActivity through AndroidView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/classic_article_body" />

    <!-- Loads and renders for the view tree's lifecycle owner (the hosting Activity); GONE if nothing loads. -->
    <com.company.admob.views.AdNativeView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:company_admob_placement="mixed_xml_in_compose_native"
        app:company_admob_template="small_button_end" />
</LinearLayout>
