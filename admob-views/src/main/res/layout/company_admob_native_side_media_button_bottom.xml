<?xml version="1.0" encoding="utf-8"?>
<!-- side_media_button_bottom: the "Ad" strip, icon, headline and body beside the media, then a full-width call to action. -->
<!-- Overdraw: the template is embedded in your screen, not a window root. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/company_admob_nativeBackground"
    android:orientation="vertical"
    android:padding="@dimen/company_admob_native_spacing"
    android:theme="@style/CompanyAdMob.ThemeOverlay.Native"
    tools:ignore="Overdraw">

    <include layout="@layout/company_admob_native_part_strip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/company_admob_native_spacing"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include layout="@layout/company_admob_native_part_header_plain" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/company_admob_native_media"
            android:layout_width="0dp"
            android:layout_height="@dimen/company_admob_native_media_height_compact"
            android:layout_marginStart="@dimen/company_admob_native_spacing"
            android:layout_weight="1.3"
            android:contentDescription="@string/company_admob_native_media_description" />
    </LinearLayout>

    <android.widget.Button
        android:id="@+id/company_admob_native_cta"
        style="@style/CompanyAdMob.Native.Cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/company_admob_native_spacing" />

</LinearLayout>
