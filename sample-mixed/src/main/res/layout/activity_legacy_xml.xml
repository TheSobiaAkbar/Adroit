<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legacy_xml_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/xml_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/show_interstitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/show_interstitial" />

            <TextView
                android:id="@+id/last_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Compose inside the XML screen: AdNative, kept by this Activity across rotation. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- An XML banner, bound to this Activity's lifecycle. -->
    <com.company.admob.views.AdBannerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:company_admob_bannerSize="anchoredAdaptive"
        app:company_admob_placement="mixed_legacy_banner" />
</LinearLayout>
