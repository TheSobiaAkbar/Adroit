<?xml version="1.0" encoding="utf-8"?>
<!--
    The top strip of the templates whose first row isn't the header: the "Ad" badge at the start, and room at the end
    for the AdChoices icon the SDK adds in the top corner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/company_admob_native_adchoices_space"
    android:paddingEnd="@dimen/company_admob_native_adchoices_space">

    <TextView
        android:id="@+id/company_admob_native_attribution"
        style="@style/CompanyAdMob.Native.Attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical" />
</FrameLayout>
